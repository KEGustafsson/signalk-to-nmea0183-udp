{
  "name": "signalk-to-nmea0183-udp",
  "version": "1.0.0",
  "description": "Signal K server plugin to convert Signal K to NMEA0183 and send it over UDP",
  "repository": {
    "url": "https://github.com/KEGustafsson/signalk-to-nmea0183-udp"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "engines": {
    "//": "Floor at 20.10 to support Venus CerboGX firmware (currently Node 20.18.2). Bump back to >=22 once Cerbo ships a newer Node.",
    "node": ">=20.10"
  },
  "files": [
    "dist",
    "public",
    "logo.svg",
    "docs/screenshots",
    "README.md",
    "LICENSE"
  ],
  "signalk": {
    "displayName": "SK to NMEA0183 (UDP)",
    "appIcon": "./logo.svg"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "build:config": "webpack",
    "clean": "rimraf dist public",
    "prebuild": "npm run clean",
    "typecheck": "tsc --noEmit",
    "test": "mocha",
    "coverage": "c8 --reporter=text --reporter=lcov npm test",
    "mutation": "stryker run",
    "prettier:check": "prettier --check .",
    "prettier": "prettier --write .",
    "format": "npm run prettier",
    "prepublishOnly": "npm test && npm run typecheck && npm run build && npm run build:config"
  },
  "keywords": [
    "signalk-node-server-plugin",
    "signalk-plugin-configurator",
    "nmea0183",
    "udp"
  ],
  "author": "teppo.kurki@iki.fi",
  "license": "Apache-2.0",
  "devDependencies": {
    "@signalk/server-api": "^2.30.0",
    "@stryker-mutator/core": "^9.6.1",
    "@stryker-mutator/mocha-runner": "^9.6.1",
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.19.17",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "baconjs": "^3.0.0",
    "c8": "^11.0.0",
    "mocha": "^11.8.0",
    "prettier": "^3.9.6",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "rimraf": "^6.1.3",
    "ts-loader": "^9.6.2",
    "tsx": "^4.23.7",
    "typescript": "^6.0.3",
    "webpack": "^5.109.2",
    "webpack-cli": "^7.2.2",
    "ws": "^8.21.2"
  },
  "overrides": {
    "diff": "^8.0.3",
    "serialize-javascript": "^7.0.5"
  },
  "c8": {
    "extension": [
      ".ts",
      ".tsx"
    ],
    "include": [
      "src/**/*.ts"
    ],
    "exclude": [
      "test/**",
      "coverage/**",
      "dist/**",
      "src/types/**"
    ],
    "all": true,
    "reporter": [
      "text",
      "lcov"
    ]
  }
}
